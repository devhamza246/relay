# Copy to .env (chmod 600). Generate secrets with: openssl rand -hex 24
RELAY_ADMIN_DB_PASSWORD=
RELAY_APP_DB_PASSWORD=
RELAY_ADMIN_TOKEN=

# rules | replay (default, never calls the API) | auto (recordings first, live on a miss) | live. auto and live need a key.
RELAY_LLM_MODE=replay
ANTHROPIC_API_KEY=
RELAY_DAILY_SPEND_CAP_USD=0.05
RELAY_VISITOR_LIVE_PER_DAY=8

# Slack incoming webhook for handoffs. Empty = dry run: the payload is recorded and shown, nothing is sent.
SLACK_WEBHOOK_URL=
